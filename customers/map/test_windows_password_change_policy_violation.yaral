rule test_windows_password_change_policy_violation {
  meta:
    author = "Jason Murray"
    description = "Finds successful logins from users who have not changed their windows (AD) password in 6 months by correlating login events with Entity Graph state."
    //This is less likely to find a regular user account than an account that is misconfigured intentionally, for example, an admin account that innapropriately does not expire.
    severity = "Low"

  events:
    // Event 1: The successful Windows user login
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.platform = "WINDOWS"
    $login.security_result.action = "ALLOW" 
    $login.target.user.userid = $userid

    // Event 2: Fetch the User Entity from the Entity Graph
    $user.graph.metadata.entity_type = "USER"
    $user.graph.entity.user.userid = $userid

    // Grab the stored state of when their password was last changed
    $last_password_change = $user.graph.entity.user.last_password_change_time.seconds

    // Compare: The login event timestamp must be 6 months (15552000s) greater than the last password change time
    $login.metadata.event_timestamp.seconds > ($last_password_change + 15552000)

  match:
    // Have any successful windows logins of this user ID happened in the last 12 hours while their account password had not been changed in 6 months
    $userid over 12h

  condition:
    // $login collectively establishes that a successful windows login for a given user occured.
    // $user is establishing a refernce to a given user in the entity tables that will contain a static value for when the user last changed their password.
    $login and $user
}
 
